# Copy to .env and set the values for your environment

# Sync Version (used by Alembic migrations)
ENGLISH_DATABASE_MIGRATION_URL="mssql+pyodbc://<username>:<password>@<host>:1433/<database>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes&LongAsMax=Yes"

# Async Version (used by the application at runtime)
ENGLISH_DATABASE_URL="mssql+aioodbc://<username>:<password>@<host>:1433/<database>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes&LongAsMax=Yes"

# Authentication (JWT tokens issued by the Identity Service)
SECRET_TOKEN_KEY=<i.e. openssl rand -hex 32>
AUTH_ALGORITHM=<The algorithm to use, for instance: HS256>
TOKEN_TIME_DELTA_IN_MINUTES=<INT>
TOKEN_URL=<The token URL, for instance: /token>

# Service identity (must match the service registration in the Identity Service)
SERVICE_ID=<UUID of this service>
SERVICE_NAME=english-service

# LLM Provider Configuration
# Supported values: openai, anthropic
LLM_PROVIDER=openai
LLM_API_KEY=<your-api-key>
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# Logging & CORS
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*

# Azure Monitor (Application Insights) - optional
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

METRICS_COLLECTION_INTERVAL=60
